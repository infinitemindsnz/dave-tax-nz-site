---
/**
 * Hero — a 1:1 port of the `Hero()` component in src/App.jsx.
 *
 * The markup is frozen: element order, class names and attributes must match
 * the React source exactly, because src/styles.css is a verbatim copy and its
 * selectors (`.alert-link svg:first-child`, `.hero__portrait>img`, …) depend on
 * this shape. Every user-visible string comes from the content model — nothing
 * is hardcoded here.
 *
 * Icons were `@phosphor-icons/react@2.1.10` components. They are inlined below
 * as raw SVG. The React `IconBase` rendered
 *   <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size}
 *        fill="currentColor" viewBox="0 0 256 256">…</svg>
 * with any extra props appended after `viewBox`, and picked one `<path>` from
 * the weight map. The literals below reproduce that output, path data copied
 * verbatim from dist/defs/<Icon>.es.js. Do not re-draw, re-minify or reorder
 * the path data — the glyphs are the design.
 *
 *   ShieldCheck size={35} weight="light"   → alert-link leading badge
 *   ArrowRight  size={20} weight="regular" → alert-link trailing chevron
 *   Phone       size={21} weight="fill"    → "Call Dave" secondary button
 */
import { site } from "../lib/content";

const { hero } = site;
const { alert, portrait, caption } = hero;

// Icons this component knows how to draw for a CTA. `icon: null` renders no
// icon at all. Anything else is a content/markup mismatch, and a silently
// dropped icon would be a visual regression — so fail the build instead.
const CTA_ICONS = new Set<string>(["Phone"]);
const unsupported = hero.ctas.find((cta) => cta.icon !== null && !CTA_ICONS.has(cta.icon));
if (unsupported) {
  throw new Error(
    `Hero.astro cannot draw the "${unsupported.icon}" icon requested by the CTA ` +
      `"${unsupported.label}" in src/data/site.yaml. Inline that Phosphor glyph here first.`,
  );
}
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">{hero.headline}</h1>
    <div class="accent-rule" aria-hidden="true"></div>
    <p class="hero__lead">{hero.lead}</p>
    <a class="alert-link" href={alert.href}><svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" viewBox="0 0 256 256"><path d="M208,42H48A14,14,0,0,0,34,56v56c0,51.94,25.12,83.4,46.2,100.64,22.73,18.6,45.27,24.89,46.22,25.15a6,6,0,0,0,3.16,0c.95-.26,23.49-6.55,46.22-25.15C196.88,195.4,222,163.94,222,112V56A14,14,0,0,0,208,42Zm2,70c0,37.76-13.94,68.39-41.44,91.06A131.17,131.17,0,0,1,128,225.72a130.94,130.94,0,0,1-40.56-22.66C59.94,180.39,46,149.76,46,112V56a2,2,0,0,1,2-2H208a2,2,0,0,1,2,2ZM172.24,99.76a6,6,0,0,1,0,8.48l-56,56a6,6,0,0,1-8.48,0l-24-24a6,6,0,0,1,8.48-8.48L112,151.51l51.76-51.75A6,6,0,0,1,172.24,99.76Z"></path></svg><span>{alert.text}</span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></a>
    <div class="button-row">{
      hero.ctas.map((cta) => (
        <a
          class={cta.variant === "secondary" ? "button button--secondary" : "button"}
          href={cta.href}
          target={cta.external ? "_blank" : undefined}
          rel={cta.external ? "noreferrer" : undefined}
        >{cta.icon === "Phone" ? (<svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="currentColor" viewBox="0 0 256 256"><path d="M231.88,175.08A56.26,56.26,0,0,1,176,224C96.6,224,32,159.4,32,80A56.26,56.26,0,0,1,80.92,24.12a16,16,0,0,1,16.62,9.52l21.12,47.15,0,.12A16,16,0,0,1,117.39,96c-.18.27-.37.52-.57.77L96,121.45c7.49,15.22,23.41,31,38.83,38.51l24.34-20.71a8.12,8.12,0,0,1,.75-.56,16,16,0,0,1,15.17-1.4l.13.06,47.11,21.11A16,16,0,0,1,231.88,175.08Z"></path></svg>) : null}{cta.icon === null ? cta.label : ` ${cta.label}`}</a>
      ))
    }</div>
  </div>
  <div class="hero__portrait"><img
      src={portrait.src}
      alt={portrait.alt}
      width={portrait.width}
      height={portrait.height}
    /><div class="portrait-caption"><strong>{caption.name}</strong><span>{caption.role}</span><small>{caption.note}</small></div></div>
</section>
