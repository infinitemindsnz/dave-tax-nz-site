---
/**
 * Contact section — port of `Contact()` in src/App.jsx.
 *
 * Markup parity notes:
 *  - Class names, element order and attributes match the React output exactly.
 *    The action link is the shared `ActionLink … external` (class "button",
 *    target="_blank", rel="noreferrer"); the contact rows only carry
 *    target/rel on the external maps link, as in App.jsx.
 *  - Icons were `<Phone size={27} weight="fill" />`,
 *    `<EnvelopeSimple size={27} weight="fill" />`,
 *    `<GlobeHemisphereWest size={27} />` (regular) and
 *    `<Check size={28} weight="bold" />` from @phosphor-icons/react@2.1.10.
 *    Path data and IconBase's attribute set are inlined verbatim.
 *  - The content model's `contact.rows` carry no icon field, so the row icon is
 *    derived from the link scheme — tel: → Phone, mailto: → EnvelopeSimple,
 *    http(s): → GlobeHemisphereWest — which reproduces App.jsx's fixed order
 *    without inventing a schema key.
 *
 * All copy comes from the content model; nothing here is hardcoded.
 */
import { site } from "../lib/content";

const { contact } = site;
const isExternal = (href: string) => href.startsWith("http");
---

<section id="contact" class="contact">
  <div class="section-shell contact__grid">
    <div><p class="eyebrow eyebrow--gold">{contact.eyebrow}</p><h2>{contact.heading}</h2><p>{contact.intro}</p></div>
    <div class="contact__links">{contact.rows.map((row) => (
      <a href={row.href} {...(isExternal(row.href) ? { target: "_blank", rel: "noreferrer" } : {})}>{row.href.startsWith("tel:") ? (<svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" fill="currentColor" viewBox="0 0 256 256"><path d="M231.88,175.08A56.26,56.26,0,0,1,176,224C96.6,224,32,159.4,32,80A56.26,56.26,0,0,1,80.92,24.12a16,16,0,0,1,16.62,9.52l21.12,47.15,0,.12A16,16,0,0,1,117.39,96c-.18.27-.37.52-.57.77L96,121.45c7.49,15.22,23.41,31,38.83,38.51l24.34-20.71a8.12,8.12,0,0,1,.75-.56,16,16,0,0,1,15.17-1.4l.13.06,47.11,21.11A16,16,0,0,1,231.88,175.08Z"></path></svg>) : row.href.startsWith("mailto:") ? (<svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" fill="currentColor" viewBox="0 0 256 256"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-8,144H40V74.19l82.59,75.71a8,8,0,0,0,10.82,0L216,74.19V192Z"></path></svg>) : (<svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm88,104a87.62,87.62,0,0,1-6.4,32.94l-44.7-27.49a15.92,15.92,0,0,0-6.24-2.23l-22.82-3.08a16.11,16.11,0,0,0-16,7.86h-8.72l-3.8-7.86a15.91,15.91,0,0,0-11-8.67l-8-1.73L96.14,104h16.71a16.06,16.06,0,0,0,7.73-2l12.25-6.76a16.62,16.62,0,0,0,3-2.14l26.91-24.34A15.93,15.93,0,0,0,166,49.1l-.36-.65A88.11,88.11,0,0,1,216,128ZM143.31,41.34,152,56.9,125.09,81.24,112.85,88H96.14a16,16,0,0,0-13.88,8l-8.73,15.23L63.38,84.19,74.32,58.32a87.87,87.87,0,0,1,69-17ZM40,128a87.53,87.53,0,0,1,8.54-37.8l11.34,30.27a16,16,0,0,0,11.62,10l21.43,4.61L96.74,143a16.09,16.09,0,0,0,14.4,9h1.48l-7.23,16.23a16,16,0,0,0,2.86,17.37l.14.14L128,205.94l-1.94,10A88.11,88.11,0,0,1,40,128Zm102.58,86.78,1.13-5.81a16.09,16.09,0,0,0-4-13.9,1.85,1.85,0,0,1-.14-.14L120,174.74,133.7,144l22.82,3.08,45.72,28.12A88.18,88.18,0,0,1,142.58,214.78Z"></path></svg>)}<span><small>{row.label}</small>{row.value}</span></a>
    ))}</div>
    <div class="contact__action"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg><p>{contact.action.title}</p><a class="button" href={contact.action.ctaHref} target="_blank" rel="noreferrer">{contact.action.ctaLabel}</a></div>
  </div>
</section>
