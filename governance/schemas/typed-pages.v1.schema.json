{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dave-tax-nz-site.vercel.app/schemas/typed-pages.v1.schema.json",
  "title": "Dave Tax governed typed pages",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/serviceDetail" }
    }
  },
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069<>]*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "section": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "heading", "body"],
          "properties": {
            "kind": { "const": "prose" },
            "heading": { "$ref": "#/$defs/heading" },
            "body": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "heading", "items"],
          "properties": {
            "kind": { "const": "list" },
            "heading": { "$ref": "#/$defs/heading" },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/listItem" }
            }
          }
        }
      ]
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069<>]*$"
    },
    "listItem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069<>]*$"
    },
    "serviceDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageType", "slug", "title", "description", "sections"],
      "properties": {
        "pageType": { "const": "service_detail" },
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069<>]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069<>]*$" },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    }
  }
}
